<UserControl x:Class="KeyStats.Views.Controls.KeyBreakdownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:KeyStats.ViewModels"
             xmlns:p="clr-namespace:KeyStats.Properties"
             MinHeight="24">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Column 1 -->
        <ItemsControl x:Name="Column1" Grid.Column="0"
                      ItemsSource="{Binding Column1Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewmodels:KeyCountItem}">
                    <Grid Height="22" Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SubtleFillBrush}"
                                CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       MaxWidth="45" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Key}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Count}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Column 2 -->
        <ItemsControl x:Name="Column2" Grid.Column="2"
                      ItemsSource="{Binding Column2Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewmodels:KeyCountItem}">
                    <Grid Height="22" Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SubtleFillBrush}"
                                CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       MaxWidth="45" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Key}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Count}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Column 3 -->
        <ItemsControl x:Name="Column3" Grid.Column="4"
                      ItemsSource="{Binding Column3Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewmodels:KeyCountItem}">
                    <Grid Height="22" Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SubtleFillBrush}"
                                CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       MaxWidth="45" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Key}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Count}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty State: 三列皆空时才显示，随 ItemsControl.HasItems 自动刷新 -->
        <TextBlock x:Name="EmptyText" Grid.ColumnSpan="5"
                   Text="{x:Static p:Strings.KeyBreakdown_Empty}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasItems, ElementName=Column1}" Value="False"/>
                                <Condition Binding="{Binding HasItems, ElementName=Column2}" Value="False"/>
                                <Condition Binding="{Binding HasItems, ElementName=Column3}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
