<Window x:Class="KeyStats.Views.MouseScrollCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:KeyStats.Properties"
        Title="{x:Static p:Strings.ScrollCalibration_WindowTitle}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowSurfaceBrush}"
        ShowInTaskbar="False">

    <StackPanel Margin="24,20">
        <TextBlock Text="{x:Static p:Strings.ScrollCalibration_HeaderTitle}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="{x:Static p:Strings.ScrollCalibration_Instruction}"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,8" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Static p:Strings.ScrollCalibration_WidthLabel}"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="WidthTextBox" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"
                         TextChanged="Input_TextChanged"/>

                <TextBlock Grid.Row="1" Text="{x:Static p:Strings.ScrollCalibration_HeightLabel}"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="HeightTextBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"
                         TextChanged="Input_TextChanged"/>

                <TextBlock Grid.Row="2" Text="{x:Static p:Strings.ScrollCalibration_DiagonalLabel}"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="DiagonalTextBox" Grid.Row="2" Grid.Column="1" Margin="8,0,0,0"
                         TextChanged="Input_TextChanged"/>
            </Grid>
        </Border>

        <TextBlock x:Name="CurrentPpiText" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,4"/>
        <TextBlock x:Name="ResultText" Text="{x:Static p:Strings.ScrollCalibration_ResultEmpty}" FontSize="13"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static p:Strings.Common_Cancel}" MinWidth="76" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="{x:Static p:Strings.ScrollCalibration_Save}" MinWidth="76"
                    IsDefault="True" IsEnabled="False" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
